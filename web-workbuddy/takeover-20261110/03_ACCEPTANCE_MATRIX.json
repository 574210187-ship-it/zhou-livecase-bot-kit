{
  "schema": "zhou-livecase-workbuddy-web-acceptance-v1",
  "preflight_must_prove": [
    "fixed_package_integrity",
    "source_full_pagination",
    "runner_status_and_dry_run_zero_write",
    "independent_auditor_existing_sample",
    "cos_head_download_sha",
    "model_structured_json",
    "durable_lease"
  ],
  "canary_must_prove": [
    "fresh_source_snapshot_candidate",
    "single_active_lease",
    "storage_readback",
    "case_library_readback",
    "q50_global_readback",
    "source_closeout_readback",
